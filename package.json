{
  "name": "opencode-pixel-agents",
  "version": "0.2.0",
  "description": "OpenCode plugin that visualizes AI agents as animated pixel art characters on a localhost web page",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist && cp -r web dist/web",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format esm --dts --out-dir dist --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "pixel-art",
    "agents",
    "visualization",
    "oh-my-opencode"
  ],
  "author": "nichelia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nichelia/pixel-agents-opencode.git"
  },
  "homepage": "https://github.com/nichelia/pixel-agents-opencode#readme",
  "bugs": {
    "url": "https://github.com/nichelia/pixel-agents-opencode/issues"
  },
  "dependencies": {
    "@opencode-ai/plugin": "latest",
    "@opencode-ai/sdk": "latest"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
